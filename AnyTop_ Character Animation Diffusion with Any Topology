.html5-video-player svg { pointer-events: none; }

.html5-video-player:not(.ytp-touch-mode) ::-webkit-scrollbar { width: 10px; background-color: rgb(66, 66, 66); }

.ytp-big-mode:not(.ytp-touch-mode) ::-webkit-scrollbar { width: 15px; }

